# Copy this file to the directory from which the kuni binary is started and
# name it config.toml. Never commit the resulting config.toml: it is secret.

[general]
character_name = "REPLACE_CHARACTER_NAME"
character_nickname = "@REPLACE_TELEGRAM_USERNAME"
papik_name = "REPLACE_OWNER_NAME"
papik_chat_id = 0
telegram_api_id = 0
telegram_api_hash = "REPLACE_TELEGRAM_API_HASH"
telegram_enabled = true
lockdown = "papik_only"

# FreeDeepseekAPI: OpenAI-compatible web-session proxy on the same VPS.
llm = { endpoint = { baseUrl = "http://127.0.0.1:9655/v1/", bearerKey = "REPLACE_WITH_PROXY_API_KEY" }, model = "deepseek-reasoner" }

# Google Gemini API: cloud embeddings for diary/RAG, no local AI model.
embedding = { endpoint = { baseUrl = "https://generativelanguage.googleapis.com/v1beta/openai/", bearerKey = "REPLACE_GEMINI_API_KEY" }, model = "gemini-embedding-001" }

[misc]
request_timeout_secs = 120

[capabilities]
vision = { enabled = false }
hearing = { enabled = false }
take_photo = { enabled = false }
record_voice = { enabled = false }
